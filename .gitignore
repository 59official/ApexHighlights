# 构建产物
bin/
obj/
*.user
*.suo
.vs/

# 本地工具链（dotnet 安装目录 + 各工具自建的 profile，合计约 900MB）
.tools/

# 发布产物（由 CI 重新构建，不进仓库）
dist/
dist_new/
dist2/
dist3/
zzz/

# 录制输出与测试素材（合计约 750MB，不进仓库）
captures/
probe/*.mp4
probe/*.png
probe/bands.bin
probe/s_*/

# 运行时日志
*.log
*.log.csv
live-*.csv

# 临时脚本
tmp_*.ps1

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store
*.stackdump

# 运行时配置（阈值/配额），用户机器上各不相同，不入库
config.json
