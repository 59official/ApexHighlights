<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ApexHighlights</AssemblyName>
    <RootNamespace>ApexHighlights</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 回顾库窗口与托盘：WinForms 是唯一能做出「单 exe、无额外依赖、双击即用」的选择 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 资源管理器 / 快捷方式 / 安装包看到的图标。由 `ApexHighlights.exe` 的 make-icon
         开关从 AppIcon.Render 生成（16 到 256 七个尺寸），换图标只要重跑那条命令 -->
    <ApplicationIcon>..\..\packaging\ApexHighlights.ico</ApplicationIcon>
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.*" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.*" />
  </ItemGroup>

  <!--
    游戏配置随 exe 内嵌。发布版是单文件，不能指望用户旁边还放着一个 games/ 目录；
    启动时 Paths.EnsureGames() 会把它们释放到数据目录，用户之后可以就地改。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\games\**\*" LogicalName="games/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    发布形态（见 docs/apex-v1-spec.md §0.1）：单个 exe，自带运行时。
    参数放在 Properties/PublishProfiles/single-file.pubxml，别写在这里 ——
    RuntimeIdentifier 写进 csproj 会把普通 build 的输出目录也改成 .../win-x64/，
    连日常开发和 run-live.bat 都跟着变，不值得。
  -->

</Project>
