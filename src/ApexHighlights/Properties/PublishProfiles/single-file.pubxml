<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布配置。用法：
    .tools\dotnet\dotnet.exe publish src\ApexHighlights\ApexHighlights.csproj -c Release -p:PublishProfile=single-file

  出来的 dist\ApexHighlights.exe 是自包含单文件，目标机器不需要装 .NET。
  不写进 csproj 的原因：RuntimeIdentifier 一旦进 csproj，普通 build 会多出 win-x64 子目录，
  run-live.bat 和日常调试路径全跟着变。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\</PublishDir>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 单文件里 PDB 没意义，还会让 dist 目录多一个 20MB 的怪文件 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
